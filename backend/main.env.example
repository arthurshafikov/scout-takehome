# Backend configuration
APP_ENV=local
APP_DEBUG=true
APP_PORT=8080

# SQLite database path (predictions.db)
SQLITE_DB_PATH=../dataset/predictions.db

# API Key for authentication
# Must match VITE_API_KEY in frontend/.env
API_KEY=scout-api-key-12345

# MinIO object storage
# For local development: localhost:9000
# For Docker: minio:9000 (service name)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=scout
MINIO_USE_SSL=false

# Thumbnail engine cache TTL
THUMBNAIL_CACHE_TTL_HOURS=24
